# ErgoGotchi Environment Variables

# Shared WebSocket Token for Telemetry Authenticity
SHARED_TOKEN=ergogotchi_sunhacks_2026_secret

# Google Gemini API Key (leaves blank to use rich built-in witty offline fallbacks)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Tiger Data / TimescaleDB Database URL
DATABASE_URL=postgresql://postgres:password123@localhost:5432/ergogotchi
USE_SQLITE_FALLBACK=true
SQLITE_DB_PATH=ergogotchi_local.db

# SpaceXSI Grok Bot / Discord Webhook URL (Optional)
GROK_WEBHOOK_URL=https://discord.com/api/webhooks/...
